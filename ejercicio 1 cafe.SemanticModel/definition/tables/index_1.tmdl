table index_1
	lineageTag: 9a22fbb2-38a5-46d5-bcc8-ade182d0dd39

	measure Ventas = SUM(index_1[money])
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: dea0a718-c9ea-42a9-82d0-c03609e98b42

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure 'Total Transacciones' = COUNT(index_1[cash_type])
		formatString: 0
		lineageTag: 369250e1-a524-4359-bdd6-8eebeb3a6c1a

	measure 'Ticket Promedio' =
			
			DIVIDE([Ventas], [Total Transacciones], 0)
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: a12c280c-adbe-4382-be06-c66eebb67f1a

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure 'Clientes Unicos' =
			
			DISTINCTCOUNT('index_1'[card])
		formatString: 0
		lineageTag: 8cc22ea6-e3b3-44c1-a1d2-9ff057f9637d

	measure 'Ingresos por Tarjeta' =
			
			CALCULATE(
			    [Ventas],
			    'index_1'[card] = "card")
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: 86d9b4de-f9e8-4594-bca7-783fbfedc70e

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure 'Ingresos por Efectivo' =
			
			CALCULATE(
			    [Ventas],
			    index_1[cash_type] = "cash")
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: 154ab5ec-22b1-4cce-bd97-a51674c87dec

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure '% Ventas Tarjeta' =
			
			DIVIDE([Ingresos por Tarjeta], [Ventas], 0)
		lineageTag: cbaa9871-8469-421e-9a44-7b557ab52fb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Producto Mas Vendido' = ```
			
			TOPN(
			    1, 
			    VALUES('index_1'[coffee_name]), 
			    [Total Transacciones], 
			    DESC
			)
			```
		lineageTag: 7ef0e813-70d2-43bb-8692-1f4d0dd5be24

	measure 'Promedio Gasto por Cliente' =
			
			DIVIDE([Ingresos por Tarjeta], [Clientes Unicos], 0)
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: bc9e726d-18be-42cd-9746-acc41c9f07a2

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure 'Ingresos YTD' =
			
			TOTALYTD([Ventas], 'Calendario'[Date])
		lineageTag: 55562e0c-af06-45c3-a976-7b3ae34b5c2c

	measure 'Ingresos Mes Anterior' = ```
			
			CALCULATE(
			    [Ventas], 
			    DATEADD('Calendario'[Date], -1, MONTH)
			)
			```
		lineageTag: a2962ff2-efe0-4a8f-9fe8-44281695e46e

