table 'Hoja Publishers y Developers'
	lineageTag: 64f46a39-b60c-41b5-9e3d-68c4bc622e04

	measure 'Juegos Por Publisher' = CALCULATE(DISTINCTCOUNT(fact_games[appid]))
		formatString: 0
		lineageTag: 3abc92b4-ebd5-49e8-a007-ed6cb59a4c82

	measure 'Precio Promedio Publisher' = AVERAGEX(FILTER(fact_games,fact_games[price] > 0 ),fact_games[price])
		lineageTag: 36d3fa77-9b4f-4f5d-8ef2-8f99decd5ff1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ranking Publisher Peor Score' = RANKX(ALL(dim_publishers),CALCULATE(DIVIDE(SUM(fact_games[positive_ratings]),SUM(fact_games[positive_ratings]) + SUM(fact_games[negative_ratings]), 0),RELATEDTABLE(fact_games)),,ASC,Dense)
		formatString: 0
		lineageTag: 997c7117-250c-4efe-abe7-c43eceb38744

	partition 'Hoja Publishers y Developers' = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	changedProperty = Name

	annotation PBI_ResultType = Table

