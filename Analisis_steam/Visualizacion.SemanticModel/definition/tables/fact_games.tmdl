	column 'Rango Precio' = IF(fact_games[price] = 0, "Gratuito", IF(fact_games[price]<= 5, "Menos de $5", IF(fact_games[price] <= 15, "$5 - $15", IF(fact_games[price] <= 30, "$15 - $30", "Más de $30"))))
		lineageTag: e18d518a-83f8-4103-931d-ddafc47b8296
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Combinacion SO' = SWITCH(TRUE(),fact_games[windows] = 1 && fact_games[mac] = 1 && fact_games[linux] = 1, "Windows + Mac + Linux", fact_games[windows] = 1 && fact_games[mac] = 1 && fact_games[linux] = 0, "Windows + Mac",fact_games[windows] = 1 && fact_games[mac] = 0 && fact_games[linux] = 1, "Windows + Linux", fact_games[windows] =  0 && fact_games[mac] = 1 && fact_games[linux] = 1, "Mac + Linux", fact_games[windows]= 1, "Solo Windows", fact_games[mac] = 1, "Solo Mac", fact_games[linux] = 1, "Solo Linux", "Desconocido")
		lineageTag: 65ed8279-82c3-4e10-8606-879a44de37ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ranking Playtime' = RANKX(ALL(fact_games),fact_games[average_playtime],,DESC,Dense)
		formatString: #,0
		lineageTag: 84a930c1-5050-40cd-b999-48238730ceb8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Segmento = ```
			
			SWITCH(
			    TRUE(),
			    fact_games[positive_ratings] >= [P75], "Top Mejores",
			    fact_games[positive_ratings] >= [P50], "Promedio",
			    fact_games[positive_ratings] >= [P25], "Mediano-Bajo",
			    "Top Peores"
			)   
			```
		lineageTag: 374b1fcb-a4f6-4954-b603-b5b91a7f3c49
